{
  "name": "crewchat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install": "pnpm install",
    "build": "pnpm -r build",
    "build:socket": "pnpm --filter @crewchat/socket... build",
    "start:socket": "pnpm --filter @crewchat/socket start",
    "dev": "pnpm -r dev",
    "dev:socket": "pnpm --filter @crewchat/socket dev",
    "dev:web": "pnpm --filter @crewchat/web dev",
    "build:web": "pnpm --filter @crewchat/web build",
    "build:db": "pnpm --filter @crewchat/db build",
    "build:message": "pnpm --filter @crewchat/message build",
    "build:chat": "pnpm --filter @crewchat/chat build",
    "build:user": "pnpm --filter @crewchat/user build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "reset": "pnpm clean && pnpm install"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3"
  }
}
