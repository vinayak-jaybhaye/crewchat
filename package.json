{
  "name": "crewchat",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:web": "pnpm --filter @crewchat/web dev",
    "dev:socket": "pnpm --filter @crewchat/socket-server dev",
    "build:web": "pnpm --filter @crewchat/web... build",
    "build:socket": "pnpm --filter @crewchat/socket-server... build",
    "start:web": "pnpm --filter @crewchat/web start",
    "start:socket": "pnpm --filter @crewchat/socket-server start"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mongoose": "^8.18.0"
  }
}
