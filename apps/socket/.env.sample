# Copy to apps/socket/.env and align secrets with apps/web/.env.local

PORT=3001
CLIENT_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://localhost:27017/crewchat

# Must match the web app exactly
AUTH_SECRET=super-long-random-string-32+chars
SOCKET_JWT_SECRET=another-super-long-random-string-32+chars