# Reference only — copy values into app-specific env files:
#   apps/web/.env.local   (see apps/web/.env.local.sample)
#   apps/socket/.env      (see apps/socket/.env.sample)
#
# Web + socket must use the SAME values for shared secrets and data stores.

MONGODB_URI=mongodb://localhost:27017/crewchat
REDIS_URL=redis://localhost:6379

AUTH_SECRET=replace-with-openssl-rand-base64-32
SOCKET_JWT_SECRET=replace-with-another-random-secret

# Web
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Socket
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
